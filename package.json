{
  "name": "snip-ask",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "框选 AI —— 屏幕框选 + AI 搜索 / 翻译 / 解答（Tauri 2 + React 18 + TypeScript）",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --port 1420 --strictPort",
    "build": "tauri build",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/windows/overlay/translationLayout.test.ts src/windows/result/thread.test.ts src/windows/main/ocr/status.test.ts src/windows/main/history/format.test.ts",
    "test:layout": "node --test src/windows/overlay/translationLayout.test.ts",
    "test:thread": "node --test src/windows/result/thread.test.ts",
    "preview:web": "vite preview --port 1422",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
