# 仓库内文本统一按 LF 检出；Windows 脚本保留 CRLF 以兼容 PowerShell 5.1
* text=auto eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.icns binary
*.bmp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.gguf binary
*.onnx binary
*.safetensors binary
*.db binary
*.zip binary
*.7z binary
*.exe binary
*.dll binary
*.pdb binary
*.rlib binary

# 锁文件与文档保持 LF
pnpm-lock.yaml text eol=lf
*.md text eol=lf

# PowerShell 脚本使用 CRLF
*.ps1 text eol=crlf

# 图标目录整体按二进制处理（避免差异对比产生噪声）
src-tauri/icons/** binary
