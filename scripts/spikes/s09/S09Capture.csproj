<Project Sdk="Microsoft.NET.Sdk">
  <!--
    S-09 spike 采集器：BitBlt / PrintWindow / WGC(Windows.Graphics.Capture) 三条路径的
    真实截图对比 + 黑屏统计。仅用于技术验证，不进入产品代码。
    目标框架使用 Windows TFM 以取得 WinRT 投影（Microsoft.Windows.SDK.NET.Ref，SDK 自带还原）。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>S09Capture</AssemblyName>
    <RootNamespace>S09Capture</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
